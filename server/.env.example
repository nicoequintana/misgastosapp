# API Key para el endpoint de integracion n8n
N8N_API_KEY=tu_api_key_segura_aqui

# Email (Resend u otro proveedor)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@tudominio.com
