# Integration Server Configuration
PORT=3001

# Supabase Admin/Secret Key (For server-side operations)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Security
N8N_API_KEY=generate-a-secure-token-here

# CORS (Frontend production URL)
FRONTEND_URL=https://your-app.vercel.app

# SMTP - Gmail (para envío de notificaciones por email)
# Usar una App Password de Google (no la contraseña de la cuenta)
# Ver: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-google
SMTP_FROM_NAME=MisGastosApp
SMTP_FROM_EMAIL=notificaciones@tudominio.com
